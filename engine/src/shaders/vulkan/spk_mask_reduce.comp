#version 450
// RFC-024: mean log paper exposure on the canonical analysis grid.
// Bindings and p[0..15] match contrast_mask.metal. Keep spectral sums in
// source order; a contraction must not change the measured material response.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Cmy { float value[]; }
cmy;
layout(set = 0, binding = 1, std430) readonly buffer Chd { float value[]; }
chd;
layout(set = 0, binding = 2, std430) readonly buffer Base { float value[]; }
base_data;
layout(set = 0, binding = 3, std430) readonly buffer Integral { float value[]; }
integral_data;
layout(set = 0, binding = 4, std430) readonly buffer Params { float value[]; }
p;
layout(set = 0, binding = 5, std430) readonly buffer Meta { uint value[]; }
meta;
layout(set = 0, binding = 6, std430) writeonly buffer Output { float value[]; }
output_data;
uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) +
           gl_GlobalInvocationID.x;
}
vec3 exposure(uint i, uint nl) {
    precise vec3 a = vec3(0);
    for (uint l = 0; l < nl; ++l) {
        precise float d = cmy.value[3 * i] * chd.value[3 * l] +
                          cmy.value[3 * i + 1] * chd.value[3 * l + 1] +
                          cmy.value[3 * i + 2] * chd.value[3 * l + 2] + base_data.value[l];
        float t = exp2(-d * 3.321928094887362);
        a += t * vec3(integral_data.value[3 * l], integral_data.value[3 * l + 1],
                      integral_data.value[3 * l + 2]);
    }
    return a * vec3(p.value[0], p.value[1], p.value[2]);
}
float mask_x(vec3 a) {
    precise float s = 0;
    for (uint c = 0; c < 3; ++c)
        s += max(log2(max(a[c] * p.value[3 + c], 0.0)), -20.0);
    return s / 3.0;
}
void main() {
    uint W = meta.value[0], H = meta.value[1], gw = meta.value[2], gh = meta.value[3],
         nl = meta.value[4], cell = spk_global_index();
    if (cell >= gw * gh)
        return;
    uint cy = cell / gw, cx = cell % gw, x0 = cx * W / gw,
         x1 = min(max((cx + 1) * W / gw, x0 + 1), W), y0 = cy * H / gh,
         y1 = min(max((cy + 1) * H / gh, y0 + 1), H);
    precise float acc = 0;
    for (uint y = y0; y < y1; ++y)
        for (uint x = x0; x < x1; ++x)
            acc += mask_x(exposure(y * W + x, nl));
    output_data.value[cell] = acc / float((x1 - x0) * (y1 - y0));
}
